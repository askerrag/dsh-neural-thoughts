{
  "name": "@local/neural-thoughts",
  "version": "1.7.0",
  "private": true,
  "description": "Read-only 3D neural map for DeepSeek Harness chats and projects, with skill/MCP call tracking, history playback, class lens, event cards, media gallery, text-file viewer and eight languages.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.ru.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "author": "Neural mind contributors",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "web-ui",
    "3d",
    "brain",
    "visualization",
    "reasoning",
    "media",
    "mcp"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "scripts": {
    "check": "node --check client.js && node --check index.js"
  }
}
